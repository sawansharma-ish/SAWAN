rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Reusable Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'sawanforwork@gmail.com' ||
        request.auth.token.email == 'admin@auraweb.in'
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Shape Type Guards ---
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'role']) &&
             data.keys().size() <= 8 &&
             data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 100 &&
             data.role is string && (
               data.role == 'Client' ||
               data.role == 'Admin' ||
               data.role == 'Super Admin' ||
               data.role == 'Staff'
             );
    }

    function isValidLead(data) {
      return data.keys().hasAll(['id', 'name', 'email']) &&
             data.keys().size() <= 12 &&
             data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 100;
    }

    function isValidInquiry(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'message', 'timestamp']) &&
             data.keys().size() <= 10 &&
             data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 100 &&
             data.message is string && data.message.size() <= 5000;
    }

    // --- Collection Routes ---

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      
      allow create: if isValidId(userId) && 
                      isOwner(userId) && 
                      isValidUser(incoming()) && 
                      // Prevent clients from assigning themselves Admin roles on signup
                      (incoming().role == 'Client' || isAdmin());

      allow update: if isValidId(userId) && 
                      isOwner(userId) && 
                      isValidUser(incoming()) && 
                      // Prevent modifying roles and critical registers without admin privileges
                      (incoming().role == existing().role || isAdmin()) &&
                      (incoming().keys().hasAll(existing().keys()));

      allow delete: if isAdmin();
    }

    match /leads/{leadId} {
      allow create: if isValidId(leadId) && isValidLead(incoming());
      
      // Keep sensitive prospective deal details restricted to staff and admins
      allow get, list, update, delete: if isAdmin();
    }

    match /inquiries/{inquiryId} {
      allow create: if isValidId(inquiryId) && isValidInquiry(incoming());
      
      // Restrict read/reply permissions to admins
      allow get, list, update, delete: if isAdmin();
    }
  }
}
