{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profiling for AURA WEB including Roles and History",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "role": { "type": "string" },
        "registerDate": { "type": "string", "format": "date-time" },
        "lastLogin": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "email", "role"]
    },
    "Lead": {
      "title": "Lead",
      "description": "Captured Lead Information from forms and calculators",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "businessName": { "type": "string" },
        "service": { "type": "string" },
        "budget": { "type": "string" },
        "message": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["new", "contacted", "in-progress", "closed"] }
      },
      "required": ["id", "name", "email"]
    },
    "Inquiry": {
      "title": "Inquiry",
      "description": "Contact form submissions for general inquiries",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "message": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "replied": { "type": "boolean" },
        "replyText": { "type": "string" }
      },
      "required": ["id", "name", "email", "message", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/leads/{leadId}": {
      "schema": "Lead",
      "description": "Collected prospective client leads"
    },
    "/inquiries/{inquiryId}": {
      "schema": "Inquiry",
      "description": "Client contact submissions"
    }
  }
}
